<Page x:Class="Patterns.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Patterns.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Grid.RowSpan="2" Margin="10">
            <TextBlock Text="Фильтр по категории:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="FilterComboBox" Margin="0,0,0,20" SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="Все" IsSelected="True"/>
                <ComboBoxItem Content="Еда"/>
                <ComboBoxItem Content="Транспорт"/>
                <ComboBoxItem Content="Жильё"/>
                <ComboBoxItem Content="Развлечения"/>
                <ComboBoxItem Content="Другое"/>
            </ComboBox>
            <TextBlock x:Name="TotalSumTextBlock" Text="Итого: 0 руб." FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Добавить расход" Width="130" Height="30" Margin="0,0,10,0" Click="AddButton"/>
            <Button Content="Экспорт отчёта" Width="130" Height="30" Click="ExportButton"/>
        </StackPanel>

        <ListView x:Name="ExpensesListView" HorizontalAlignment="Stretch" Grid.Column="1" Grid.Row="1" Margin="5">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="DarkOliveGreen" BorderThickness="1">
                        <Grid Background="White" Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="250"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Category}" FontSize="16" FontWeight="Bold" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding Date, StringFormat=dd.MM.yyyy}" FontSize="13" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock FontSize="14" Margin="0,0,0,2">
                                    <Run Text="Сумма: " Foreground="Gray"/>
                                    <Run Text="{Binding Sum}" FontWeight="Bold"/>
                                    <Run Text=" руб."/>
                                </TextBlock>
                                <TextBlock FontSize="13" TextWrapping="Wrap">
                                    <Run Text="Описание: " Foreground="Gray"/>
                                    <Run Text="{Binding Description}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
    </Grid>
    
</Page>
